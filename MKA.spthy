theory Simplified_MKA

begin

builtins: hashing

functions:
  a/0,
  b/0,
  kek/0,
  ick/0,
  sak/0,
  atf/2,
  enc/2,
  dec/2,
  mac/2,
  mkapdu/2

equations:
  dec(enc(x,k),k) = x

rule InstallSharedCAK:
  [ Fr(~Cak) ]
  --[ CAKInstalled(~Cak) ]->
  [ !CAK(a,~Cak), !CAK(b,~Cak) ]

rule SendMKAPDU_A:
  [ !CAK(a,Cak), Fr(~Sa) ]
  --[ SentMKAPDU(a,~Sa) ]->
  [ Out(pair(mkapdu(a,~Sa), mac(mkapdu(a,~Sa), atf(Cak,ick)))), Speed(a,~Sa) ]

rule SendMKAPDU_B:
  [ !CAK(b,Cak), Fr(~Sb) ]
  --[ SentMKAPDU(b,~Sb) ]->
  [ Out(pair(mkapdu(b,~Sb), mac(mkapdu(b,~Sb), atf(Cak,ick)))), Speed(b,~Sb) ]

rule DeriveKeys_A:
  [ !CAK(a,Cak) ]
  --[ DerivedKeys(a) ]->
  [ !KEK(a,atf(Cak,kek)), !ICK(a,atf(Cak,ick)) ]

rule DeriveKeys_B:
  [ !CAK(b,Cak) ]
  --[ DerivedKeys(b) ]->
  [ !KEK(b,atf(Cak,kek)), !ICK(b,atf(Cak,ick)) ]

rule ReceiveMKAPDU_B:
   [ In(pair(P, mac(P, atf(Cak,ick)))), !CAK(b,Cak), !ICK(b,atf(Cak,ick)) ]
  --[ ReceivedMKAPDU(b,a) ]->
   [ PeerSpeed(a), PeerDiscovered(b,a) ]

rule ReceiveMKAPDU_A:
   [ In(pair(P, mac(P, atf(Cak,ick)))), !CAK(a,Cak), !ICK(a,atf(Cak,ick)) ]
  --[ ReceivedMKAPDU(a,b) ]->
   [ PeerSpeed(b), PeerDiscovered(a,b) ]
rule AHasHigherSpeed:
  [ PeerSpeed(a), PeerSpeed(b), !CAK(a,Cak) ]
  --[]->
  [ Higher(a,b) ]

rule BHasHigherSpeed:
  [ PeerSpeed(a), PeerSpeed(b), !CAK(a,Cak) ]
  --[]->
  [ Higher(b,a) ]

rule CreateSAK_A:
  [ Higher(a,b), !CAK(a,Cak) ]
  --[ SAKCreated(a,atf(Cak,sak)) ]->
  [ !SAK(a,atf(Cak,sak)) ]

rule CreateSAK_B:
  [ Higher(b,a), !CAK(b,Cak) ]
  --[ SAKCreated(b,atf(Cak,sak)) ]->
  [ !SAK(b,atf(Cak,sak)) ]

rule SendSAK_A:
  [ !SAK(a,sak), !KEK(a,kek), !ICK(a,ick) ]
  --[ SentSAK(a,sak) ]->
  [ Out(pair(enc(sak,kek), mac(enc(sak,kek),ick))) ]

rule SendSAK_B:
  [ !SAK(b,sak), !KEK(b,kek), !ICK(b,ick) ]
  --[ SentSAK(b,sak) ]->
  [ Out(pair(enc(sak,kek), mac(enc(sak,kek),ick))) ]

rule ReceiveSAK_A:
  [ In(pair(ciph, mac(ciph,ick))), !KEK(a,kek), !ICK(a,ick) ]
  --[ SessionEstablished(a,dec(ciph,kek)) ]->
  [ InstalledSAK(a,dec(ciph,kek)) ]

rule ReceiveSAK_B:
  [ In(pair(ciph, mac(ciph,ick))), !KEK(b,kek), !ICK(b,ick) ]
  --[ SessionEstablished(b,dec(ciph,kek)) ]->
  [ InstalledSAK(b,dec(ciph,kek)) ]

rule RevealCAK_A:
  [ !CAK(a,Cak) ]
  --[ CAKReveal(a) ]->
  [ Out(Cak) ]

rule RevealCAK_B:
  [ !CAK(b,Cak) ]
  --[ CAKReveal(b) ]->
  [ Out(Cak) ]

lemma sak_agreement:
"
All X K #i.
SessionEstablished(X,K) @ i ==>
Ex Y #j.
SentSAK(Y,K) @ j
"

lemma sak_secrecy:
"
All X K #i.
SessionEstablished(X,K) @ i ==>
(
  not(Ex #j. K(K) @ j)
  |
  Ex Y #r. CAKReveal(Y) @ r
)
"

end